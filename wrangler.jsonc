{
  // Static-assets-only Cloudflare Worker. No server code needed:
  // the puzzles are generated in the browser from today's date.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plate-math",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application"
  }
}
